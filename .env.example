# Run python3 scripts/init-env.py to create .env with two random, distinct secrets.
BRIDGE_BIND=127.0.0.1:8787
BRIDGE_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-bytes
BRIDGE_API_KEY=replace-with-a-different-random-secret
BRIDGE_CREDENTIAL_DB=.bridge/credentials.redb
BRIDGE_WEB_DIR=web/dist
BRIDGE_CLI_BARE=0
# CLAUDE_CLI_PATH=/absolute/path/to/claude
# BRIDGE_MAX_CONCURRENCY=4
# BRIDGE_TIMEOUT_SECONDS=180
# BRIDGE_OAUTH_TIMEOUT_SECONDS=600

# Compose only: host port; container always listens on 8787.
# BRIDGE_PORT=8788
# BRIDGE_IMAGE_TAG=latest
